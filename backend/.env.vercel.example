# Vercel Environment Variables: copy values individually, never commit secrets.
NODE_ENV=production
DB_DRIVER=postgres
# Use the exact HTTPS domain assigned to this Vercel project.
# APP_ORIGIN=https://YOUR-CUSTOM-DOMAIN.example
# Omit APP_ORIGIN to use Vercel's production domain automatically.
COOKIE_SECURE=true
JWT_SECRET=REUSE_THE_EXISTING_JWT_SECRET_FROM_BACKEND_ENV

# Copy PostgreSQL values from .env.supabase; use transaction pooler port 6543.
PGHOST=YOUR-POOLER-HOST.pooler.supabase.com
PGPORT=6543
PGDATABASE=postgres
PGUSER=postgres.YOUR_PROJECT_REF
PGPASSWORD=YOUR_DATABASE_PASSWORD
PGSCHEMA=ttnava_stage
PGPOOL_SIZE=1
PGSSLROOTCERT=certs/supabase-ca.crt

STORAGE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_LOCALLY
SUPABASE_STORAGE_BUCKET=ttnava-private
