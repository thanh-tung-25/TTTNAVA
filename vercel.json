{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["hnd1"],
  "installCommand": "npm ci --prefix backend --omit=dev --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node backend/scripts/build-vercel.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{frontend/pages/**,backend/certs/supabase-ca.crt}",
      "excludeFiles": "{backend/.env*,backend/backups/**,tai-lieu/**,**/*.log}"
    }
  },
  "routes": [
    { "src": "/socket.io/socket.io.js", "dest": "/assets/vendor/socket.io.min.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
