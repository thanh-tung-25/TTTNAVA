# Vercel Environment Variables: copy values individually, never commit secrets.
NODE_ENV=production
DB_DRIVER=postgres
# Use the exact HTTPS domain assigned to this Vercel project.
# APP_ORIGIN=https://YOUR-CUSTOM-DOMAIN.example
# Omit APP_ORIGIN to use Vercel's production domain automatically.
COOKIE_SECURE=true
JWT_SECRET=REUSE_THE_EXISTING_JWT_SECRET_FROM_BACKEND_ENV

# Copy PostgreSQL values from .env.supabase; use transaction pooler port 6543.
PGHOST=YOUR-POOLER-HOST.pooler.supabase.com
PGPORT=6543
PGDATABASE=postgres
PGUSER=postgres.YOUR_PROJECT_REF
PGPASSWORD=YOUR_DATABASE_PASSWORD
PGSCHEMA=ttnava_stage
PGPOOL_SIZE=1
PGSSLROOTCERT=certs/supabase-ca.crt

STORAGE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_LOCALLY
SUPABASE_STORAGE_BUCKET=ttnava-private

# Chinese speaking: copy the SAME Groq organization key after enabling Global ZDR.
CHINESE_SPEAKING_AI_ENABLED=false
GROQ_API_KEY=
GROQ_ZERO_DATA_RETENTION_CONFIRMED=false
CHINESE_SPEAKING_DAILY_LIMIT=5

# Gmail OTP: add these to the Production environment, then redeploy.
REGISTRATION_ENABLED=false
REGISTRATION_MAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional alternative: provider=resend and a verified sending domain.
RESEND_API_KEY=
REGISTRATION_FROM_EMAIL=

# Friends-only calls: apply PostgreSQL migration 038 BEFORE enabling.
CHAT_CALLS_ENABLED=false
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CHAT_CALL_MAX_SECONDS=900
CHAT_CALL_MAX_CONCURRENT=5
CHAT_CALL_MONTHLY_MINUTES=3000
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
