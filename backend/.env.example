# Sao chep file nay thanh .env va dien gia tri thuc. KHONG commit .env.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=kids_learning
DB_POOL_SIZE=10
DB_SSL=false
# Khi trien khai Aiven: DB_SSL=true va DB_CA_PATH=certs/aiven-ca.pem

# Bat buoc: chuoi ngau nhien >= 32 ky tu
JWT_SECRET=thay-bang-secret-ngau-nhien-toi-thieu-32-ky-tu
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Chi dung cho script tao admin dau tien
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Quan tri vien

# Tuy chon: chi bat khi admin chu dong tao cau hoi tu tai lieu chi co kien thuc.
# Endpoint phai tuong thich OpenAI Chat Completions.
AI_QUESTION_ENABLED=false
AI_QUESTION_API_URL=
AI_QUESTION_API_KEY=
AI_QUESTION_MODEL=

# Optional Chinese speaking assessment via Groq Free. Only text/scores are saved.
# One backend key handles transcription and grading; no camera or media storage.
CHINESE_SPEAKING_AI_ENABLED=false
GROQ_API_KEY=
# Set true only AFTER enabling Zero Data Retention in Groq Data Controls.
GROQ_ZERO_DATA_RETENTION_CONFIRMED=false
CHINESE_SPEAKING_DAILY_LIMIT=5

# Dang ky Gmail + OTP: chi bat sau khi cau hinh gui email that.
REGISTRATION_ENABLED=false
REGISTRATION_MAIL_PROVIDER=gmail
# Gmail rieng cua website; bat xac minh 2 buoc va tao Mat khau ung dung.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Lua chon khac: REGISTRATION_MAIL_PROVIDER=resend (can ten mien da xac minh).
RESEND_API_KEY=
REGISTRATION_FROM_EMAIL=
