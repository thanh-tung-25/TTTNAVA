{
  "name": "tttnava",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "description": "TTNAVA - web app trac nghiem cho hoc sinh tieu hoc (HTML/CSS/JS thuan + Express + MySQL)",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "start": "npm --prefix backend start",
    "build:vercel": "node backend/scripts/build-vercel.mjs",
    "preflight:deploy": "node backend/scripts/check-deployment.mjs",
    "test": "npm --prefix backend test",
    "test:e2e": "playwright test",
    "test:speaking": "playwright test --config playwright.speaking.config.js",
    "test:admin-ui": "playwright test --config playwright.admin.config.js",
    "test:student-ui": "playwright test --config playwright.student.config.js",
    "test:ai-chat": "playwright test --config playwright.ai-chat.config.js",
    "test:courses": "playwright test --config playwright.courses.config.js",
    "test:worksheets": "playwright test --config playwright.worksheets.config.js",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed-catalog": "npm --prefix backend run db:seed-catalog",
    "db:seed-secondary": "npm --prefix backend run db:seed-secondary",
    "test:secondary": "playwright test --config playwright.secondary.config.js",
    "questions:legacy": "npm --prefix backend run questions:legacy",
    "seed:admin": "npm --prefix backend run seed:admin"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
