{
  "name": "tttnava-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API Express + MySQL cho TTNAVA",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed-catalog": "node scripts/seed-catalog.js",
    "db:seed-secondary": "node scripts/seed-secondary.js",
    "migration:inventory": "node scripts/platform-migration-export.mjs",
    "migration:export": "node scripts/platform-migration-export.mjs --export",
    "migration:verify": "node scripts/platform-migration-verify.mjs",
    "db:check-supabase": "node scripts/check-supabase.mjs",
    "db:check-postgres": "node --use-system-ca scripts/check-postgres-core.mjs",
    "storage:inventory": "node --use-system-ca scripts/migrate-private-storage.mjs",
    "storage:migrate": "node --use-system-ca scripts/migrate-private-storage.mjs --apply",
    "questions:legacy": "node scripts/legacy-question-status.js",
    "seed:admin": "node scripts/create-admin-user.js",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "supertest": "^7.3.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "socket.io-client": "^4.8.4",
    "vitest": "^5.0.5"
  }
}
